SONORA_SECRET_KEY=replace-with-a-long-random-secret
SONORA_DEBUG=0
SONORA_DEMO_MODE=1
SONORA_ALLOWED_HOSTS=localhost,127.0.0.1,backend
SONORA_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SONORA_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SONORA_FRONTEND_URL=http://localhost:5173
SONORA_STREAM_SIGNING_MAX_AGE_SECONDS=600

# Zarinpal sandbox (https://www.zarinpal.com/docs/paymentGateway/sandBox.html)
# Default is on. Set SONORA_ZARINPAL_ENABLED=0 for instant mock checkout.
SONORA_ZARINPAL_ENABLED=1
SONORA_ZARINPAL_SANDBOX=1
SONORA_ZARINPAL_MERCHANT_ID=c8d2f8b6-07c1-496c-9f4c-f8e8afae1955
# Required when Zarinpal is enabled: absolute Django callback URL (set this yourself).
SONORA_ZARINPAL_CALLBACK_URL=http://localhost:8000/api/v1/payments/zarinpal/callback/
